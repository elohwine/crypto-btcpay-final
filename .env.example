# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# For Render deployment: Set DATABASE_URL to the External Database URL from 
# your Render managed Postgres dashboard. Include sslmode=require.
# Example format:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/cryptoplatform?sslmode=require
#
# For local development: Use LOCAL_DATABASE_URL or point DATABASE_URL to localhost.
# If using docker-compose.override.yml with local Postgres:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cryptoplatform
# Alternative: Use LOCAL_DATABASE_URL for explicit local fallback
# LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cryptoplatform

# API
API_PORT=3001
JWT_SECRET=replace_me_with_strong_secret

# ============================================================================
# BTCPAY CONFIGURATION (optional - for BTCPay Server integration)
# ============================================================================
# Set BTCPAY_ENABLED=true only when you want to use BTCPay Server
# Leave false or unset to use TRON-only minimal mode
BTCPAY_ENABLED=false
SKIP_BTCPAY=true
# Uncomment and configure when enabling BTCPay:
# BTCPAY_HOST=http://localhost:49392
# BTCPAY_API_KEY=your_api_key_here
# BTCPAY_STORE_ID=your_store_id_here
# BTCPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ============================================================================
# TRON NETWORK CONFIGURATION
# ============================================================================
# Default receiver address for TRON deposits (used when BTCPay is disabled)
TRON_DEFAULT_RECEIVER=TQK3DrqthcDJNdMZGmBXDLMznGqa72pcLG

# TRON Network (shasta = testnet, mainnet for production)
TRON_NETWORK=shasta
TRON_PROVIDER_URL=https://api.shasta.trongrid.io
TRON_USDT_DECIMALS=6

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
# API URL accessible from the frontend client (browser)
NEXT_PUBLIC_API_URL=http://localhost:3001
# CORS origin for API (where frontend is served from)
FRONTEND_ORIGIN=http://localhost:3000

