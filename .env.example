# Example environment file for docker-compose deployments
# Clean, single-file version using docker-compose hostnames so services
# started with `docker compose up` can communicate without edits.
# NOTE: These values were copied from your active `.env`. They contain
# secrets and API keys exactly as provided — consider rotating secrets
# and removing secrets from the repository after use.

# Database (Postgres)
DATABASE_URL=postgresql://postgres:postgres@db:5432/cryptoplatform

# API
API_PORT=3001
JWT_SECRET=replace_me

# BTCPay (use docker-compose service hostname so the API can reach BTCPay)
# When running under compose the API should reach BTCPay at http://btcpay:49392
BTCPAY_HOST=http://btcpay:49392
BTCPAY_API_KEY=ebf33b89136f38a9c0219e26c05cd7f1fe0ed95a
BTCPAY_STORE_ID=Cz77Wgp1Zd4TdEWUvLR8a69ZbM34CKnFEQiEjgt1Z9QQ
BTCPAY_WEBHOOK_SECRET=3o9ZGywzve7VZcrbLrwUiw1W1LRo

# Default receiver address for TRON (used by deposit flows)
TRON_DEFAULT_RECEIVER=TQK3DrqthcDJNdMZGmBXDLMznGqa72pcLG

# TRON Network Configuration
TRON_NETWORK=shasta
TRON_PROVIDER_URL=https://api.shasta.trongrid.io
TRON_USDT_DECIMALS=6

# Frontend (the runtime/build-time API host used by the frontend)
# For docker-compose this points to the `api` service. If you deploy the
# frontend and API to separate hosts, set NEXT_PUBLIC_API_URL to the public API URL
NEXT_PUBLIC_API_URL=http://api:3001
FRONTEND_ORIGIN=http://frontend
# Example environment file for docker-compose deployments
# This mirrors your runtime `.env` but uses docker-compose service hostnames
# so services started by `docker compose up` can communicate without edits.
# You can copy-paste these values into Render or another host as environment
# variables. NOTE: these values contain live keys from your current `.env`.

# Database (Postgres)
DATABASE_URL=postgresql://postgres:postgres@db:5432/cryptoplatform

# API
API_PORT=3001
JWT_SECRET=replace_me

# BTCPay (use docker-compose service hostname so the API can reach BTCPay)
# When running locally with docker-compose the host should be `btcpay`.
BTCPAY_HOST=http://btcpay:49392
BTCPAY_API_KEY=ebf33b89136f38a9c0219e26c05cd7f1fe0ed95a
BTCPAY_STORE_ID=Cz77Wgp1Zd4TdEWUvLR8a69ZbM34CKnFEQiEjgt1Z9QQ
BTCPAY_WEBHOOK_SECRET=3o9ZGywzve7VZcrbLrwUiw1W1LRo
TRON_DEFAULT_RECEIVER=TQK3DrqthcDJNdMZGmBXDLMznGqa72pcLG

# TRON Network Configuration
TRON_NETWORK=shasta
TRON_PROVIDER_URL=https://api.shasta.trongrid.io
TRON_USDT_DECIMALS=6

# Frontend (the runtime/build-time API host used by the frontend)
# For docker-compose this points to the `api` service. If you deploy the
# frontend and API to separate hosts, set this to the public API URL.
NEXT_PUBLIC_API_URL=http://api:3001
# Database (Postgres)
DATABASE_URL=postgresql://postgres:postgres@db:5432/cryptoplatform

