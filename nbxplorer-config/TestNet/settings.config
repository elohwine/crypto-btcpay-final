## NBXplorer TestNet settings - point node endpoint to bitcoind in compose
btc.rpc.url=http://bitcoind:18332/
btc.rpc.user=bitcoin
btc.rpc.password=bitcoin
btc.node.endpoint=bitcoind:18333

# Allow unauthenticated HTTP API for local development (NBXplorer will not require API keys/cookie auth)
noauth=1
